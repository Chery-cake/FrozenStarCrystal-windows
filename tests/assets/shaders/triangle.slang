// A trivially simple solid-color triangle shader.
struct VSOut {
    float4 position : SV_Position;
    float4 color    : COLOR0;
};

[shader("vertex")]
VSOut vs_main(uint vertexID : SV_VertexID)
{
    // Full-triangle clipped-space coords, generated by SV_VertexID.
    float2 pos[3] = {
        float2(-0.5, -0.5),
        float2( 0.5, -0.5),
        float2( 0.0,  0.5),
    };

    VSOut o;
    o.position = float4(pos[vertexID], 0.0, 1.0);
    o.color    = float4(1.0, 0.5, 0.2, 1.0);
    return o;
}

[shader("fragment")]
float4 fs_main(VSOut i) : SV_Target
{
    return i.color;
}
