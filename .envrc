# Add scripts directory to PATH
PATH_add scripts

# If Nix is available, load the flake environment
if command -v nix >/dev/null 2>&1 || [ -e /etc/NIXOS ] || [ -e /run/current-system/sw ]; then
  use flake
else
  echo "Nix not found – flake environment not loaded"
fi

# Set config file path (default to project root .fsc_config)
export FSC_CONFIG_FILE="${FSC_CONFIG_FILE:-$PWD/.fsc_config}"

# Ensure config file exists (create with defaults if missing)
if [ ! -f "$FSC_CONFIG_FILE" ]; then
  echo "Creating default .fsc_config..."
  settings >/dev/null 2>&1
fi

# Source the config and export its variables
if [ -f "$FSC_CONFIG_FILE" ]; then
  source "$FSC_CONFIG_FILE"
  echo "Loaded settings from $FSC_CONFIG_FILE"
fi
